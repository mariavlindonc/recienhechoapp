# Copiar a .env (cp .env.example .env). Nunca commitear .env.

# Servicios
API_GATEWAY_PORT=8080
USUARIOS_PORT=8081
PRODUCTOS_PORT=8082
PEDIDOS_PORT=8083
NOTIFICACIONES_PORT=8084

# Mock del contrato de notificaciones
NOTIFICACIONES_MOCK_PORT=4010

# Notificaciones: claves de API con el formato grupo:clave,grupo:clave (valores de desarrollo)
NOTIFICACIONES_CLAVES_API=grupo-x:una-clave-larga-de-desarrollo

# MongoDB de notificaciones (valores de desarrollo; en un entorno real van otros)
NOTIFICACIONES_MONGO_PORT=27017
NOTIFICACIONES_MONGO_USUARIO=notificaciones
NOTIFICACIONES_MONGO_CLAVE=desarrollo

# MongoDB de pedidos (valores de desarrollo). Desde la compu: mongodb://localhost:27020/?directConnection=true
PEDIDOS_MONGO_PORT=27020
PEDIDOS_MONGO_USUARIO=pedidos
PEDIDOS_MONGO_CLAVE=desarrollo

# Inventario falso de pedidos (ADR-010): confirma, sin_stock, lento, error o rechazo
INVENTARIO_MODO=confirma

# RabbitMQ (ADR-003, valores de desarrollo). Web de administración en http://localhost:15672
RABBITMQ_USUARIO=recienhecho
RABBITMQ_CLAVE=desarrollo
RABBITMQ_WEB_PORT=15672

# Servidor de correo: Mailpit por defecto. Para Gmail en la demo (ADR-005):
# SMTP_HOST=smtp.gmail.com, SMTP_PUERTO=587, SMTP_USUARIO y SMTP_CLAVE (contraseña de aplicación).
SMTP_HOST=mailpit
SMTP_PUERTO=1025
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=Recién hecho <avisos@recienhecho.test>
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Jaeger: web para ver las trazas (ADR-006)
JAEGER_WEB_PORT=16686

# Prometheus y Grafana (ADR-006). La clave de admin de Grafana es de desarrollo.
PROMETHEUS_WEB_PORT=9090
GRAFANA_WEB_PORT=3000
GRAFANA_ADMIN_CLAVE=desarrollo
